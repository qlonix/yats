{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YATS",
  "version": "1.3.2",
  "identifier": "com.yats.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "YATS Settings",
        "width": 800,
        "height": 600,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2024-2026 QLO (qlonix). All rights reserved.",
    "homepage": "https://github.com/qlonix/yats",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Yet Another Touchpad Shortcut for Linux/Windows",
    "longDescription": "YATS is a cross-platform utility that enhances touchpad functionality by providing custom shortcuts and gesture support. It allows users to assign keyboard shortcuts to touchpad gestures for improved productivity.",
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "resources": [
      "resources/*"
    ],
    "publisher": "QLO (qlonix)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "depends": [
          "xdotool",
          "wmctrl"
        ],
        "files": {
          "/etc/udev/rules.d/99-yats-touchpad.rules": "resources/99-yats-touchpad.rules"
        }
      }
    }
  }
}