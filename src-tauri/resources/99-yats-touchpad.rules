# YATS Touchpad Access Rules
# This file grants users access to touchpad input devices for YATS functionality.
# Install to: /etc/udev/rules.d/99-yats-touchpad.rules
# Then run: sudo udevadm control --reload-rules && sudo udevadm trigger

# Allow access to touchpad devices (common patterns)
SUBSYSTEM=="input", KERNEL=="event[0-9]*", ATTRS{name}=="*[Tt]ouchpad*", MODE="0666"
SUBSYSTEM=="input", KERNEL=="event[0-9]*", ATTRS{name}=="*[Gg]lidepoint*", MODE="0666"
SUBSYSTEM=="input", KERNEL=="event[0-9]*", ATTRS{name}=="*[Tt]rackpad*", MODE="0666"
SUBSYSTEM=="input", KERNEL=="event[0-9]*", ATTRS{name}=="*[Ss]ynaptics*", MODE="0666"
SUBSYSTEM=="input", KERNEL=="event[0-9]*", ATTRS{name}=="*ELAN*", MODE="0666"
SUBSYSTEM=="input", KERNEL=="event[0-9]*", ATTRS{name}=="*ALPS*", MODE="0666"
SUBSYSTEM=="input", KERNEL=="event[0-9]*", ATTRS{name}=="*DTP*", MODE="0666"
SUBSYSTEM=="input", KERNEL=="event[0-9]*", ATTRS{name}=="*bcm5974*", MODE="0666"
